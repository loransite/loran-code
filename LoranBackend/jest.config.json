{
  "testEnvironment": "node",
  "testTimeout": 60000,
  "coveragePathIgnorePatterns": [
    "/node_modules/"
  ],
  "testMatch": [
    "**/__tests__/**/*.test.js"
  ],
  "collectCoverageFrom": [
    "controller/**/*.js",
    "middleware/**/*.js",
    "services/**/*.js",
    "!**/node_modules/**"
  ]
}
